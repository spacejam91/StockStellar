# Copy to .env and adjust.

# Which market-data source the scanner uses:
#   mock    -> deterministic synthetic bars, offline (default).
#              Plants events: dev data and a smoke test, NOT a null case.
#   null    -> driftless random walk, nothing to find. The Test 10 harness.
#   signal  -> null plus a strong planted signal. The positive control.
#   yahoo   -> real daily bars via yfinance. Free, unofficial, back-adjusted
#              (so fine for building, not for a calibration log you trust).
MARKET_DATA=mock
