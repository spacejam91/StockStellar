# Copy to .env and adjust if needed.

# Which backend to use:
#   mock   → simulated account + positions, no IB Gateway needed
#   yahoo  → REAL quotes from Yahoo Finance (~15min delayed), simulated trades
#   ibkr   → real ib_async connection to IB Gateway
BACKEND=yahoo

# Only used when BACKEND=ibkr
# Port 4002 = paper trading, 4001 = live trading via IB Gateway
# Port 7497 = paper trading, 7496 = live via TWS desktop app
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# Bulk market data for the scanner — READ ONLY, separate from BACKEND above.
# BACKEND is the broker (account/positions/orders); this is universe-scale bars.
#   mock   → deterministic synthetic bars, offline, no setup (default)
#   yahoo  → real daily bars via yfinance: free, unofficial, and BACK-ADJUSTED,
#            so a calibration log built from it is not point-in-time
MARKET_DATA=mock
